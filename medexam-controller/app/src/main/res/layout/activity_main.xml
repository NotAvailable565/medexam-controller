<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:padding="24dp">

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="医考助手"
        android:textSize="24sp"
        android:textStyle="bold"
        android:layout_marginBottom="4dp" />

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="手柄按键 -> 无障碍点击，不依赖坐标"
        android:textSize="13sp"
        android:textColor="#888888"
        android:layout_marginBottom="24dp" />

    <TextView
        android:id="@+id/status_text"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="○ 无障碍服务未启用"
        android:textSize="16sp"
        android:layout_marginBottom="16dp" />

    <Button
        android:id="@+id/btn_open_settings"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="打开无障碍设置"
        android:layout_marginBottom="20dp" />

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="医考帮的包名（限定生效范围）"
        android:textSize="13sp"
        android:layout_marginBottom="4dp" />

    <EditText
        android:id="@+id/package_edit"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:hint="先用调试模式获取，见下方说明"
        android:layout_marginBottom="8dp" />

    <Button
        android:id="@+id/btn_save"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="保存"
        android:layout_marginBottom="20dp" />

    <Button
        android:id="@+id/debug_toggle"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="调试模式：关"
        android:layout_marginBottom="24dp" />

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="按键映射：\nA/B/X/Y -> A/B/C/D选项\nR1 -> E选项\nL1 -> 提交/确认\nD-Pad左右 -> 上一题/下一题\nD-Pad上下 -> 滚动\nStart -> 下一题  Select -> 上一题"
        android:textSize="12sp"
        android:textColor="#999999"
        android:lineSpacingMultiplier="1.4" />

</LinearLayout>
